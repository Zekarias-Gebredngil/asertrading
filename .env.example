# ==============================================================================
# Aser Trading Backend - Environment Configuration Template
# Copy this file to '.env' and populate with your environment-specific secrets.
# NEVER commit the real '.env' file to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Service Configuration
# Used by docker-compose and Spring Boot datasource
# ------------------------------------------------------------------------------
POSTGRES_DB=asertrading_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5439
DB_HOST=localhost

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Spring Boot Datasource Connection
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5439/asertrading_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# Must be at least 256 bits (32 bytes) hex-encoded for HMAC-SHA256
# ------------------------------------------------------------------------------
JWT_SECRET=your_hex_encoded_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# Application Server & Networking
# ------------------------------------------------------------------------------
PORT=8085
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://127.0.0.1:4200
APP_MEDIA_BASE_URL=http://localhost:8085
APP_UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# Optional: Cloud Storage (AWS S3 / MinIO / DigitalOcean Spaces)
# ------------------------------------------------------------------------------
AWS_S3_ENABLED=false
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_URL_PREFIX=

